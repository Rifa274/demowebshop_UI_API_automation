    {
      "name": "Update User",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nvar resData = pm.response.json();\r\nvar reqData = JSON.parse(pm.request.body.raw);\r\n\r\npm.test(\"Returned ID matches stored variable\", function () {\r\n    var storedId = pm.collectionVariables.get(\"userId\");\r\n    pm.expect(resData.id.toString()).to.eql(storedId.toString());\r\n});\r\n\r\npm.test(\"Phone should not be empty\", function () {\r\n    pm.expect(resData.phone).to.be.a('string').and.not.empty;\r\n});\r\n\r\npm.test(\"Name matches updated dynamic name\", function () {\r\n    pm.expect(resData.name).to.eql(reqData.name);\r\n});"
            ]
          }
        }
      ],
